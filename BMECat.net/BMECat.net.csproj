<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <Authors>Stephan Stapel, stephan@s2-industries.com</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/stephanstapel/BMECat.net</PackageProjectUrl>	
    <Version>4.6.0</Version>
    <Copyright>Stephan Stapel, s2 industries, 2026</Copyright>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/stephanstapel/BMECat.net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>bme;product;catalog;catalogue;bmecat;pim</PackageTags>
    <Description>BMECat.net is an open source .NET library for reading and writing BMEcat product catalogs. It reads BMEcat 1.2 and 2005 (including 2005fd and the many non-conformant files found in practice) into a version independent object model with products, prices, order details, features, MIME infos, references, logistics data, parties and catalog structures. Catalogs are written as BMEcat 2005 documents that conform to the official schema. Supports .NET Standard 2.0, .NET 8 and .NET 10.</Description>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
	<FileVersion>4.6.0.0</FileVersion>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <AssemblyName>s2industries.BMECat.net</AssemblyName>
    <AssemblyOriginatorKeyFile>BMECat.net.snk</AssemblyOriginatorKeyFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReleaseNotes>4.6.0:
- Writer: buyer and supplier as parties incl. contact details, product features and classification, MIME infos, catalog structure with product to group mappings, product references and logistics details
- Writer: documents conform to the BMEcat 2005 schema, uses the BMEcat 2005 namespace instead of 2005fd, STOCK and the deprecated EAN element are no longer written (the EAN is written as INTERNATIONAL_PID)
- Reader: fixes for parties, product order, encodings, German dates and the catalog name of BMEcat 2005 documents
- Reading and writing of numbers and dates independent from the machine culture
- Non-seekable streams are rejected with IllegalStreamException, temporary files are always cleaned up
- New target frameworks: netstandard2.0, net8.0 and net10.0</PackageReleaseNotes>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	<PackageId>BMECat.net</PackageId>
	<UserSecretsId>044793d4-c1be-4cfb-b376-3573fa56847b</UserSecretsId>
	<SignAssembly>False</SignAssembly>
	<EmbedUntrackedSources>true</EmbedUntrackedSources>
	<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	<Title>Comprehensive BMECat library for .net</Title>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
	<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403" PrivateAssets="All" />
  </ItemGroup>
</Project>
